# Copy to `.env.local` and adjust. Everything here is optional: with no
# configuration at all ShareGo uses its own `/api/signal` route on whichever
# address you opened the page from.
#
# ---------------------------------------------------------------------------
# Browser (NEXT_PUBLIC_* values are inlined into the client bundle at build time,
# so changing them requires a restart of `next dev`, not just a reload)
# ---------------------------------------------------------------------------

# Optional override for the signaling endpoint. Leave it unset unless the
# signaling route is served from a different origin than the page — for example
# a phone opening `http://192.168.1.20:3000` while the browser tab is on a
# tunnel. A bare origin is enough; `/api/signal` is appended for you.
# NEXT_PUBLIC_SIGNALING_URL=http://192.168.1.20:3000

# ---------------------------------------------------------------------------
# Server only (never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Upstash Redis credentials, from the Vercel integration.
#
# Not needed locally, and not needed on a deployment that runs a single
# instance. They *are* needed as soon as the platform runs more than one
# instance of the app, because presence and relay messages then have to be
# shared between them. Without them the app still starts, and the activity log
# says so, but two devices can fail to find each other.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# WebRTC tuning
# ---------------------------------------------------------------------------

# STUN server used to learn a public address when devices are not on the same
# LAN. Leave empty to use only host candidates (the pure "nothing leaves your
# network" mode).
# NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302

# Full ICE server list, as JSON. Use this to add a TURN relay:
#   [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# NEXT_PUBLIC_ICE_SERVERS=

# Bytes per DataChannel frame. Larger = slightly better throughput on Wi-Fi,
# more memory per in-flight file.
# NEXT_PUBLIC_TRANSFER_CHUNK_SIZE=65536

# Stop feeding the DataChannel once its send buffer exceeds this. Lower values
# help on weak links at the cost of throughput.
# NEXT_PUBLIC_TRANSFER_HIGH_WATER_MARK=4194304

# How many files a single peer may stream to us at once.
# NEXT_PUBLIC_MAX_CONCURRENT_TRANSFERS=4