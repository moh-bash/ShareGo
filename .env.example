# Copy to `.env.local` and adjust. Browser values are optional for local
# development; the two Upstash values are required by the Vercel WebSocket
# function in production.

# ---------------------------------------------------------------------------
# Browser (NEXT_PUBLIC_* values are inlined into the client bundle at build time,
# so changing them requires a restart of `next dev`, not just a reload)
# ---------------------------------------------------------------------------

# Optional override for the signaling WebSocket. If unset, production derives
# `wss://<current-host>/api/ws`, while local HTTP development derives
# `ws://<current-host>:8080`.
# NEXT_PUBLIC_SIGNALING_URL=ws://192.168.1.20:8080

# Required by the Vercel WebSocket function. Create these through the Upstash
# Redis Vercel integration; they are server-only and must not be NEXT_PUBLIC_*.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# STUN server used to learn a public address when devices are not on the same
# LAN. Leave empty to use only host candidates (the pure "nothing leaves your
# network" mode).
# NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302

# Full ICE server list, as JSON. Use this to add a TURN relay:
#   [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# NEXT_PUBLIC_ICE_SERVERS=

# Bytes per DataChannel frame. Larger = slightly better throughput on Wi-Fi,
# more memory per in-flight file.
# NEXT_PUBLIC_TRANSFER_CHUNK_SIZE=65536

# Stop feeding the DataChannel once its send buffer exceeds this. Lower values
# help on weak links at the cost of throughput.
# NEXT_PUBLIC_TRANSFER_HIGH_WATER_MARK=4194304

# How many files a single peer may stream to us at once.
# NEXT_PUBLIC_MAX_CONCURRENT_TRANSFERS=4

# ---------------------------------------------------------------------------
# Local signaling server (read by `npm run signal` / `npm run dev:all`)
# ---------------------------------------------------------------------------

# Port to listen on. Hosting providers may inject PORT; SIGNALING_PORT takes
# precedence when both are set. Use 8080 unless something else owns it.
# SIGNALING_PORT=8080

# Bind address. 0.0.0.0 accepts connections from other devices on the LAN.
# Bind 127.0.0.1 to make the server unreachable from anywhere but this machine.
# SIGNALING_HOST=0.0.0.0